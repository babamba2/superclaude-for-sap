/hud/lib/sc4sap-status.mjs\")","source":"localSettings"},{"rule":"Bash(cp \"C:/Users/pssps/Documents/Projects/sc4sap_project/sc4sap/scripts/hud/statusline.mjs\" \"C:/Users/pssps/.claude/plugins/cache/sc4sap/sc4sap/0.3.5/scripts/hud/statusline.mjs\")","source":"localSettings"},{"rule":"Read(//c/Users/pssps/.claude/plugins/cache/sc4sap/sc4sap/0.3.5/scripts/**)","source":"localSettings","root":"/c/","pattern":"/Users/pssps/.claude/plugins/cache/sc4sap/sc4sap/0.3.5/scripts"},{"rule":"Read(//c/Users/pssps/.claude/plugins/cache/sc4sap/sc4sap/0.3.5/**)","source":"localSettings","root":"/c/","pattern":"/Users/pssps/.claude/plugins/cache/sc4sap/sc4sap/0.3.5"},{"rule":"Bash(dir /b)","source":"localSettings"},{"rule":"Read(//c/Users/pssps/.claude/**)","source":"localSettings","root":"/c/","pattern":"/Users/pssps/.claude"},{"rule":"mcp__claude_ai_Notion__notion-fetch","source":"localSettings"},{"rule":"mcp__claude_ai_Notion__notion-create-pages","source":"localSettings"},{"rule":"Read(.sc4sap/**)","source":"localSettings","root":null,"pattern":"/.sc4sap"},{"rule":"Read(sc4sap/**)","source":"localSettings","root":null,"pattern":"/sc4sap"},{"rule":"Edit(.sc4sap/**)","source":"localSettings","root":null,"pattern":"/.sc4sap"},{"rule":"WebFetch(domain:raw.githubusercontent.com)","source":"localSettings"},{"rule":"Bash(gh --version)","source":"localSettings"},{"rule":"Bash(gh auth *)","source":"localSettings"},{"rule":"Bash(gh pr create --base main --head active --title 'v0.3.8 — trust-session scope tightening \\(SAP handlers + .sc4sap state I/O only\\)' --body ' *)","source":"localSettings"},{"rule":"Bash(gh pr *)","source":"localSettings"},{"rule":"Bash(mkdir *)","source":"localSettings"},{"rule":"Bash(mkdir -p \"C:/Users/pssps/.claude/plugins/cache/sc4sap/sc4sap/0.3.8/data\")","source":"localSettings"},{"rule":"Bash(cp \"C:/Users/pssps/.claude/plugins/marketplaces/sc4sap/data/sc4sap-mcp-tools.md\" \"C:/Users/pssps/.claude/plugins/cache/sc4sap/sc4sap/0.3.8/data/sc4sap-mcp-tools.md\