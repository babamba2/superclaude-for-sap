).\ndiff --git a/configs/SD/tcodes.md b/configs/SD/tcodes.md\nindex 79f925f..06c98f1 100644\n--- a/configs/SD/tcodes.md\n+++ b/configs/SD/tcodes.md\n@@ -60,8 +60,10 @@\n | OVXG | ECC/S4 | Set up Sales Areas / 판매 영역 설정 |\n | OVA8 | ECC/S4 | Automatic Credit Control / 자동 신용 통제 |\n | OVZ2 | ECC/S4 | Availability Check with ATP / ATP 가용성 검사 |\n-| V/06 | ECC/S4 | Maintain Pricing Procedure / 가격 결정 절차 유지 |\n-| V/08 | ECC/S4 | Assign Pricing Procedure / 가격 결정 절차 배정 |\n+| V/06 | ECC/S4 | Maintain Condition Types / 조건 유형 유지 |\n+| V/07 | ECC/S4 | Maintain Access Sequences / 접근 순서 유지 |\n+| V/08 | ECC/S4 | Maintain Pricing Procedures / 가격 결정 절차 유지 |\n+| OVKK | ECC/S4 | Pricing Procedure Determination / 가격 결정 절차 결정 |\n \n ## Reporting\n | TCode | System | Description |\ndiff --git a/tests/validation/config-to-document.test.ts b/tests/validation/config-to-document.test.ts\nindex b63dc63..55a1a45 100644\n--- a/tests/validation/config-to-document.test.ts\n+++ b/tests/validation/config-to-document.test.ts\n@@ -278,6 +278,16 @@ describe('config-to-document — view conditions on blank values', () => {\n describe('config-to-document — edit mode', () => {\n   const meta = { module: 'MM', system: 'DEV', client: '100', sapVersion: 'ECC', extractedAt: '2026-10-14T00:00:00Z', maxRows: 1000, lang: 'ko' };\n \n+  it('opens case flows and screens in a lightbox with zoom controls', () => {\n+    const html = pageHtml({ meta, lang: 'ko', tree: [], acts: {}, views: {}, checks: [], transports: {}, domains: {}, docs: {} }, {});\n+    for (const z of ['-', '+', 'fit', 'x']) expect(html).toContain(`data-z=\"${z}\"`);\n+    expect(html).toContain('id=\"lbv\"');\n+    expect(html).toContain('화면 맞춤');\n+    // Case drawings in the reference panel are wrapped so a click reaches the lightbox.\n+    expect(html).toContain(`'<div class=\"flow\" title=\"'`);\n+    expect(html).toContain(\"closest('.flow')\");\n+  });\n+\n   it('embeds the edits as JSON that cannot close the script tag, and shows the edit butt