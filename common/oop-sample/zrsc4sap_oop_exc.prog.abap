*&---------------------------------------------------------------------*
*&  Include           ZRSC4SAP_OOP_EXC
*&---------------------------------------------------------------------*
CLASS LCL_DATA DEFINITION DEFERRED.
CLASS LCL_ALV DEFINITION DEFERRED.
DATA GO_DATA TYPE REF TO LCL_DATA.
DATA GO_ALV  TYPE REF TO LCL_ALV.

CLASS LCL_DATA DEFINITION.

  PUBLIC SECTION.

    DATA : MO_ALV    TYPE REF TO LCL_ALV.
    DATA : MT_DATA   TYPE TT_LIST.
    DATA : MT_HEADER TYPE TABLE OF TY_HEADER WITH EMPTY KEY.

    METHODS :
      CONSTRUCTOR,
      INITIALIZATION,
      HANDLE_SCREEN,
      GET_DATA,
      IS_QUANTITY_VALID
        IMPORTING IV_MENGE        TYPE MENGE_D
        RETURNING VALUE(RV_VALID) TYPE ABAP_BOOL.

ENDCLASS.

"alvFramework = s4sap-cm: base class ZCL_S4SAP_CM_ALV.
"  custom -> INHERITING FROM <alvBaseClass>; none -> no superclass, own
"  docking container + CL_GUI_ALV_GRID (see common/oop-pattern.md).
CLASS LCL_ALV DEFINITION INHERITING FROM ZCL_S4SAP_CM_ALV.

  PUBLIC SECTION.
    METHODS :
      CONSTRUCTOR,
      DISPLAY,
      STATUS_0100,
      STATUS_0200,
      SET_ALV_0100,
      SET_ALV_0200,
      USER_COMMAND_0200,
      EVENT_HOTSPOT
        IMPORTING I_ROW_ID    TYPE LVC_S_ROW
                  I_COLUMN_ID TYPE LVC_S_COL
                  IS_ROW_NO   TYPE LVC_S_ROID
                  SENDER      TYPE REF TO ZCL_S4SAP_CM_OALV OPTIONAL,
      EVENT_HOTSPOT_TREE
        IMPORTING FIELDNAME TYPE LVC_FNAME
                  NODE_KEY  TYPE LVC_NKEY
                  SENDER    TYPE REF TO ZCL_S4SAP_CM_OTREE OPTIONAL,
      EVENT_CHANGED
        IMPORTING
          IR_DATA_CHANGED TYPE REF TO CL_ALV_CHANGED_DATA_PROTOCOL
          I_ONF4          TYPE CHAR01
          I_ONF4_BEFORE   TYPE CHAR01
          I_ONF4_AFTER    TYPE CHAR01
          I_UCOMM         TYPE SY-UCOMM
          SENDER          TYPE REF TO ZCL_S4SAP_CM_OALV,
      EVENT_NODE_DOUBLE_CLICK
        IMPORTING NODE_KEY TYPE LVC_NKEY.

  PRIVATE SECTION.
    DATA : MT_NKEY TYPE TABLE OF TY_NODE WITH EMPTY KEY.

    METHODS :
      SET_TREE_0200
        RAISING ZCX_S4SAP_EXCP,
      SET_NODE_0200,
      SET_GRID_0200
        RAISING ZCX_S4SAP_EXCP,
      REFINE_FCAT
        IMPORTING IV_DYNNR TYPE SY-DYNNR
        CHANGING  CT_FCAT  TYPE LVC_T_FCAT,
      EVENT_CHANGED_MENGE
        IMPORTING
          IR_DATA_CHANGED TYPE REF TO CL_ALV_CHANGED_DATA_PROTOCOL
          IS_MOD_CELLS    TYPE LVC_S_MODI.

ENDCLASS.


CLASS LCL_DATA IMPLEMENTATION.

  METHOD CONSTRUCTOR.
    MO_ALV = NEW #( ).
  ENDMETHOD.

  METHOD INITIALIZATION.
    LV_001 = TEXT-S01.
    LV_002 = TEXT-S02.
  ENDMETHOD.

  METHOD HANDLE_SCREEN.
    " screen-field modifications for AT SELECTION-SCREEN OUTPUT
  ENDMETHOD.

  METHOD GET_DATA.

    SELECT EKKO~EBELN,
           EKKO~BSART,
           EKKO~LIFNR,
           EKPO~EBELP,
           EKPO~MENGE,
           EKPO~MEINS,
           EKPO~NETPR
      FROM EKKO
      INNER JOIN EKPO
              ON EKKO~EBELN = EKPO~EBELN
      WHERE LIFNR <> @SPACE
      INTO CORRESPONDING FIELDS OF TABLE @MT_DATA
      UP TO 100 ROWS.

    MT_HEADER = CORRESPONDING #( MT_DATA ).

  ENDMETHOD.

  METHOD IS_QUANTITY_VALID.
    RV_VALID = XSDBOOL( IV_MENGE > 0 ).
  ENDMETHOD.

ENDCLASS.


CLASS LCL_ALV IMPLEMENTATION.

  METHOD CONSTRUCTOR.

    FIELD-SYMBOLS <FS_EVENTLIST> TYPE ZCL_S4SAP_CM_ALV_EVENT=>TY_EVENTLIST.

    SUPER->CONSTRUCTOR( ).

    "alvFramework: the base class creates the E-include receivers by name
    ME->MO_ALV_EVENT = NEW #( IV_LOCAL_CLASS_DEFINITION = 'LCL_EVENT_ALV' ).
    IF ME->MO_ALV_EVENT IS NOT INITIAL.
      LOOP AT ME->MO_ALV_EVENT->MT_EVENTLIST ASSIGNING <FS_EVENTLIST>
           WHERE EVENT = C_HANDLE_HOTSPOT_CLICK
              OR EVENT = C_HANDLE_DATA_CHANGED.
        <FS_EVENTLIST>-METHOD = <FS_EVENTLIST>-EVENT.
      ENDLOOP.
    ENDIF.

    ME->MO_TREE_EVENT = NEW #( IV_LOCAL_CLASS_DEFINITION = 'LCL_EVENT_TREE' ).
    IF ME->MO_TREE_EVENT IS NOT INITIAL.
      LOOP AT ME->MO_TREE_EVENT->MT_EVENTLIST ASSIGNING <FS_EVENTLIST>
           WHERE EVENT = C_HANDLE_LINK_CLICK
              OR EVENT = C_HANDLE_NODE_DOUBLE_CLICK.
        <FS_EVENTLIST>-METHOD = <FS_EVENTLIST>-EVENT.
      ENDLOOP.
    ENDIF.

  ENDMETHOD.

  METHOD DISPLAY.

    CASE ABAP_TRUE.
      WHEN P_01.
        ME->MV_DYNNR = C_DYNNR_0100.
      WHEN P_02.
        ME->MV_DYNNR = C_DYNNR_0200.
    ENDCASE.
    CALL SCREEN ME->MV_DYNNR.

  ENDMETHOD.

  METHOD STATUS_0100.
    SET PF-STATUS C_STATUS_0100.
  ENDMETHOD.

  METHOD STATUS_0200.
    SET PF-STATUS C_STATUS_0200.
  ENDMETHOD.

  METHOD SET_ALV_0100.

    IF LINE_EXISTS( ME->MT_OALV[ DYNNR = SY-DYNNR ] ).
      ME->REFRESH_ALV( ).
      RETURN.
    ENDIF.

    TRY.
        DATA(LO_DOCK) = ME->CREATE_DOCK_CONTAINER( ).
        ME->CREATE_ALV_GRID( IO_PARENT_DOCK = LO_DOCK ).
        ME->SET_LAYOUT( VALUE #( STYLEFNAME = 'CELLSTYL' CTAB_FNAME = 'CELLSCOL' SEL_MODE = 'A' ) ).
        DATA(LT_FCAT) = ME->GET_FIELDCAT( IT_DATA = GO_DATA->MT_DATA ).
        REFINE_FCAT( EXPORTING IV_DYNNR = C_DYNNR_0100
                     CHANGING  CT_FCAT  = LT_FCAT ).
        ME->SET_FIELDCAT( IT_FCAT = LT_FCAT ).
        ME->SET_REGISTER_EVENT( IV_MODIFIED = ABAP_TRUE IV_ENTER = ABAP_TRUE ).
        ME->SET_EVENT_HANDLER( IO_EVENT = ME->MO_ALV_EVENT ).
        ME->DISPLAY_ALV( CHANGING IT_DATA = GO_DATA->MT_DATA ).

      CATCH ZCX_S4SAP_EXCP INTO DATA(LO_ERROR).
        MESSAGE LO_ERROR->GET_TEXT( ) TYPE 'I' DISPLAY LIKE 'E'.
    ENDTRY.

  ENDMETHOD.

  METHOD SET_ALV_0200.

    IF LINE_EXISTS( ME->MT_OALV[ DYNNR = SY-DYNNR ] ).
      ME->REFRESH_ALV( ).
      RETURN.
    ENDIF.

    TRY.
        ME->CREATE_SPLIT_CONTAINER( IV_ROWS = 1 IV_COLUMNS = 2 ).
        ME->SET_CONTAINER_WIDTH( IV_WIDTH = 15 ).
        SET_TREE_0200( ).
        SET_GRID_0200( ).

      CATCH ZCX_S4SAP_EXCP INTO DATA(LO_ERROR).
        MESSAGE LO_ERROR->GET_TEXT( ) TYPE 'I' DISPLAY LIKE 'E'.
        LEAVE TO SCREEN 0.
    ENDTRY.

  ENDMETHOD.

  METHOD USER_COMMAND_0200.

    CASE OK_CODE.
      WHEN C_FCODE_REFRESH.
        GO_DATA->GET_DATA( ).
        ME->REFRESH_ALV( ).
      WHEN OTHERS.
    ENDCASE.

  ENDMETHOD.

  METHOD SET_TREE_0200.

    ME->CREATE_ALV_TREE( IV_COLUMN = 1
                         IV_ITEM_SELECTION = ABAP_TRUE ).

    ME->SET_TREE_HEADER( IS_HIERARCHY_HEADER = VALUE #( HEADING   = TEXT-H01
                                                        TOOLTIP   = TEXT-H01
                                                        WIDTH     = 30
                                                        WIDTH_PIX = ABAP_TRUE ) ).

    DATA(LT_FCAT) = ME->GET_FIELDCAT( IT_DATA = GO_DATA->MT_HEADER ).
    REFINE_FCAT( EXPORTING IV_DYNNR = C_DYNNR_0200
                 CHANGING  CT_FCAT  = LT_FCAT ).
    ME->SET_TREE_FIELDCAT( IT_FCAT = LT_FCAT ).

    ME->DISPLAY_TREE( CHANGING IT_DATA = GO_DATA->MT_HEADER ).
    SET_NODE_0200( ).
    ME->SET_TREE_EVENT_HANDLER( IO_EVENT = ME->MO_TREE_EVENT ).
    ME->REFRESH_TREE( IV_COLUMNOPTIMIZATION = SPACE ).

  ENDMETHOD.

  METHOD SET_NODE_0200.

    LOOP AT GO_DATA->MT_DATA ASSIGNING FIELD-SYMBOL(<MS_DATA>)
                    GROUP BY ( EBELN = <MS_DATA>-EBELN
                               BSART = <MS_DATA>-BSART )
                    ASSIGNING FIELD-SYMBOL(<FS_GROUP>).

      DATA(LV_KEY) =
      ME->SET_TREE_ADD_NODE( IV_RELAT_NODE_KEY = SPACE
                             IV_NODE_TEXT      = CONV #( <FS_GROUP>-EBELN )
                             IS_OUTTAB_LINE    = VALUE TY_HEADER( EBELN = <FS_GROUP>-EBELN
                                                                  BSART = <FS_GROUP>-BSART )
                             IT_ITEM_LAYOUT    = VALUE #( ( FIELDNAME = CL_GUI_ALV_TREE=>C_HIERARCHY_COLUMN_NAME
                                                            CLASS     = CL_GUI_COLUMN_TREE=>ITEM_CLASS_LINK ) ) ).
      APPEND VALUE #( EBELN = <FS_GROUP>-EBELN NODE_KEY = LV_KEY ) TO MT_NKEY.

      LOOP AT GROUP <FS_GROUP> ASSIGNING FIELD-SYMBOL(<FS_ITEM>).
        LV_KEY =
        ME->SET_TREE_ADD_NODE( IV_RELAT_NODE_KEY = LV_KEY
                               IV_NODE_TEXT      = CONV #( <FS_ITEM>-EBELP )
                               IS_OUTTAB_LINE    = VALUE TY_HEADER( EBELN = <FS_GROUP>-EBELN
                                                                    EBELP = <FS_ITEM>-EBELP
                                                                    BSART = <FS_ITEM>-BSART )
                               IT_ITEM_LAYOUT    = VALUE #( ( FIELDNAME = 'EBELN'
                                                              CLASS     = CL_GUI_COLUMN_TREE=>ITEM_CLASS_LINK ) ) ).
        APPEND VALUE #( EBELN = <FS_GROUP>-EBELN NODE_KEY = LV_KEY ) TO MT_NKEY.
      ENDLOOP.

    ENDLOOP.

  ENDMETHOD.

  METHOD SET_GRID_0200.

    ME->CREATE_ALV_GRID( IV_COLUMN = 2 ).
    ME->SET_LAYOUT( VALUE #( STYLEFNAME = 'CELLSTYL' CTAB_FNAME = 'CELLSCOL' SEL_MODE = 'A' ) ).
    DATA(LT_FCAT) = ME->GET_FIELDCAT( IT_DATA = GO_DATA->MT_DATA ).
    REFINE_FCAT( EXPORTING IV_DYNNR = C_DYNNR_0100
                 CHANGING  CT_FCAT  = LT_FCAT ).
    ME->SET_FIELDCAT( IT_FCAT = LT_FCAT ).
    ME->SET_REGISTER_EVENT( IV_MODIFIED = ABAP_TRUE IV_ENTER = ABAP_TRUE ).
    ME->SET_EVENT_HANDLER( IO_EVENT = ME->MO_ALV_EVENT ).
    ME->DISPLAY_ALV( CHANGING IT_DATA = GO_DATA->MT_DATA ).

  ENDMETHOD.

  METHOD REFINE_FCAT.

    LOOP AT CT_FCAT ASSIGNING FIELD-SYMBOL(<FS_FCAT>).
      CASE IV_DYNNR.
        WHEN C_DYNNR_0100.
          CASE <FS_FCAT>-FIELDNAME.
            WHEN 'EBELN'.
              <FS_FCAT>-HOTSPOT = ABAP_TRUE.
            WHEN 'MENGE'.
              <FS_FCAT>-EDIT       = ABAP_TRUE.
              <FS_FCAT>-QFIELDNAME = 'MEINS'.
            WHEN 'CELLSTYL' OR 'CELLSCOL'.
              <FS_FCAT>-TECH = ABAP_TRUE.
          ENDCASE.
        WHEN C_DYNNR_0200.
          CASE <FS_FCAT>-FIELDNAME.
            WHEN 'EBELN' OR 'BSART'.
            WHEN OTHERS.
              <FS_FCAT>-NO_OUT = ABAP_TRUE.
          ENDCASE.
      ENDCASE.
    ENDLOOP.

  ENDMETHOD.

  METHOD EVENT_HOTSPOT.

    CHECK SENDER IS BOUND.
    READ TABLE GO_DATA->MT_DATA INDEX IS_ROW_NO-ROW_ID ASSIGNING FIELD-SYMBOL(<FS_DATA>).
    CHECK SY-SUBRC = 0.

    CASE I_COLUMN_ID-FIELDNAME.
      WHEN 'EBELN'.
        SET PARAMETER ID 'BES' FIELD <FS_DATA>-EBELN.
        CALL TRANSACTION C_TCODE_PO_DISPLAY AND SKIP FIRST SCREEN.
    ENDCASE.

  ENDMETHOD.

  METHOD EVENT_HOTSPOT_TREE.

    READ TABLE MT_NKEY WITH KEY NODE_KEY = NODE_KEY ASSIGNING FIELD-SYMBOL(<FS_NODE>).
    CHECK SY-SUBRC = 0.

    CASE FIELDNAME.
      WHEN 'EBELN' OR CL_GUI_ALV_TREE=>C_HIERARCHY_COLUMN_NAME.
        SET PARAMETER ID 'BES' FIELD <FS_NODE>-EBELN.
        CALL TRANSACTION C_TCODE_PO_DISPLAY AND SKIP FIRST SCREEN.
    ENDCASE.

  ENDMETHOD.

  METHOD EVENT_CHANGED.

    CHECK SENDER = VALUE #( ME->MT_OALV[ DYNNR = C_DYNNR_0100 ]-GRID OPTIONAL ).

    LOOP AT IR_DATA_CHANGED->MT_GOOD_CELLS ASSIGNING FIELD-SYMBOL(<FS_GCELL>)
         WHERE FIELDNAME = 'MENGE'.
      EVENT_CHANGED_MENGE( IR_DATA_CHANGED = IR_DATA_CHANGED
                           IS_MOD_CELLS    = <FS_GCELL> ).
    ENDLOOP.

  ENDMETHOD.

  METHOD EVENT_CHANGED_MENGE.

    IF GO_DATA->IS_QUANTITY_VALID( CONV MENGE_D( IS_MOD_CELLS-VALUE ) ) = ABAP_FALSE.
      "alvFramework = s4sap-cm: S_UNIFIED_CON 000 (&1 &2 &3 &4); otherwise the profile message class
      IR_DATA_CHANGED->ADD_PROTOCOL_ENTRY( I_MSGID     = C_MSGID
                                           I_MSGTY     = 'E'
                                           I_MSGNO     = '000'
                                           I_MSGV1     = TEXT-E01
                                           I_FIELDNAME = 'MENGE'
                                           I_ROW_ID    = IS_MOD_CELLS-ROW_ID ).
    ENDIF.

  ENDMETHOD.

  METHOD EVENT_NODE_DOUBLE_CLICK.

    READ TABLE MT_NKEY WITH KEY NODE_KEY = NODE_KEY ASSIGNING FIELD-SYMBOL(<FS_NODE>).
    CHECK SY-SUBRC = 0.
    SET PARAMETER ID 'BES' FIELD <FS_NODE>-EBELN.

  ENDMETHOD.

ENDCLASS.
