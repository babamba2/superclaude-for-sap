{
  "schemaVersion": 1,
  "module": "PM",
  "area": "maintenance notifications, maintenance orders, equipment, functional locations, maintenance plans",
  "notes": [
    "Business actions for /sc4sap:assist, executed only through ZMCP_BIZ_EXECUTE on the SAP side (handler ZCL_MCP_BIZ_PM).",
    "Verified on ECC only. On S/4HANA every PM action stays hidden until it is tested there.",
    "BAPI_ALM_ORDER_MAINTAIN has no test mode: order create, release, date change and TECO preview with the handler checks only. Notification status changes and confirmations preview with a BAPI test run.",
    "TECO is refused while the notification of the order is open (the BAPI fails with IWO_BAPI 162): complete the notification first.",
    "Not offered: undo TECO (no BAPI method), business completion (CLSD), order deletion, maintenance plan scheduling (IP10 / IP30), measurement documents.",
    "No person names are returned (creator, reporter, changer)."
  ],
  "actions": [
    {
      "id": "PM.ORD.LIST_OPEN",
      "object": "MaintenanceOrder",
      "kind": "query",
      "risk": "none",
      "title": "List open maintenance orders of a planning plant",
      "intents": {
        "en": [
          "open maintenance orders",
          "maintenance orders to release",
          "open work orders"
        ],
        "ko": [
          "미결 보전오더",
          "보전오더 목록",
          "릴리스할 보전오더",
          "미결 작업오더"
        ]
      },
      "params": [
        {
          "name": "werks",
          "type": "string",
          "required": true,
          "description": "maintenance planning plant"
        },
        {
          "name": "auart",
          "type": "string",
          "required": false
        },
        {
          "name": "equnr",
          "type": "string",
          "required": false
        },
        {
          "name": "tplnr",
          "type": "string",
          "required": false
        },
        {
          "name": "status",
          "type": "string",
          "required": false,
          "values": [
            "open",
            "created",
            "released"
          ]
        },
        {
          "name": "max_rows",
          "type": "string",
          "required": false,
          "description": "1-500, default 50"
        }
      ],
      "impl": {
        "ECC": {
          "source": [
            "AUFK",
            "AFIH",
            "AFKO",
            "ILOA",
            "JEST"
          ],
          "note": "SELECT on AUFK (AUTYP 30) + AFIH by planning plant; open = not TECO / CLSD / DLFL"
        },
        "S4": {
          "source": [
            "AUFK",
            "AFIH",
            "AFKO",
            "ILOA",
            "JEST"
          ],
          "note": "not verified on S/4HANA: the action stays hidden there until it is tested"
        }
      },
      "auth": [
        {
          "object": "I_IWERK",
          "fields": {
            "TCD": "IW33",
            "IWERK": "<planning plant>"
