      ],
      "verified_on": [
        {
          "alias": "ECC740-DEV",
          "family": "ECC",
          "release": "740",
          "date": "2026-11-11",
          "level": "scenario",
          "evidence": "configs/PM/actions-evidence/ECC740-DEV.txt"
