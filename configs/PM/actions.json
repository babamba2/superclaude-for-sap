    {
      "id": "PM.NOTIF.CREATE",
      "object": "MaintenanceNotification",
      "kind": "write",
      "risk": "medium",
      "title": "Create a maintenance notification",
      "intents": {
        "en": [
          "create maintenance notification",
          "report a malfunction",
          "create notification"
        ],
        "ko": [
          "보전통지 생성",
          "고장 통지 등록",
          "보전요청 등록"
        ]
      },
      "params": [
        {
          "name": "qmart",
          "type": "string",
          "required": true,
          "description": "notification type, e.g. M1 / M2"
        },
        {
          "name": "text",
          "type": "string",
          "required": true,
          "description": "short text, up to 40 characters"
        },
        {
          "name": "equnr",
          "type": "string",
          "required": false
        },
        {
          "name": "tplnr",
          "type": "string",
          "required": false
        },
        {
          "name": "werks",
          "type": "string",
          "required": false
        },
        {
          "name": "priok",
          "type": "string",
          "required": false
        }
      ],
      "impl": {
        "ECC": {
          "fm": "BAPI_ALM_NOTIF_CREATE",
          "testrun": "none",
          "commit": "BAPI_TRANSACTION_COMMIT WAIT",
          "set": "NOTIFHEADER (EQUIPMENT, FUNCT_LOC, SHORT_TEXT, PRIORITY, PLANPLANT)",
          "return": "BAPIRET2",
          "preview": "checks only: notification type (TQ80), reference object, planning plant, priority (T356), authorization; saved with BAPI_ALM_NOTIF_SAVE"
        },
        "S4": {
          "fm": "BAPI_ALM_NOTIF_CREATE",
          "testrun": "none",
          "commit": "BAPI_TRANSACTION_COMMIT WAIT",
          "set": "NOTIFHEADER (EQUIPMENT, FUNCT_LOC, SHORT_TEXT, PRIORITY, PLANPLANT)",
          "return": "BAPIRET2",
          "preview": "checks only: notification type (TQ80), reference object, planning plant, priority (T356), authorization; saved with BAPI_ALM_NOTIF_SAVE",
