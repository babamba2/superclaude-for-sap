{
  "schemaVersion": 1,
  "module": "EWM",
  "area": "embedded extended warehouse management (S/4HANA): warehouse tasks, warehouse orders, bins, stock, handling units, delivery warehouse status",
  "notes": [
    "Business actions for /sc4sap:assist, executed only through ZMCP_BIZ_EXECUTE on the SAP side (handler ZCL_MCP_BIZ_EWM, installed only on S/4HANA systems that run EWM).",
    "Queries only. Confirming, creating or cancelling warehouse tasks, bin blocks and physical inventory are not offered.",
    "On ECC the warehouse runs in classic WM: use the WM module there; EWM actions are hidden.",
    "The handler checks an EWM authorization for the warehouse number itself (/SCWM/MO or /SCWM/DLV2) and refuses when neither passes (fail closed).",
    "Products are shown with the material number (MARA-SCM_MATID_GUID16 maps the EWM product GUID). No person names are returned."
  ],
  "actions": [
    {
      "id": "EWM.WHS.LIST",
      "object": "Warehouse",
      "kind": "query",
      "risk": "none",
      "title": "List EWM warehouses (with the ERP warehouse and plants)",
      "intents": {
        "en": [
          "ewm warehouses",
          "which warehouse numbers",
          "warehouses of a plant"
        ],
        "ko": [
          "EWM 창고 목록",
          "창고번호 알려줘",
          "플랜트 창고"
        ]
      },
      "params": [
        {
          "name": "werks",
          "type": "string",
          "required": false,
          "description": "plant: only warehouses mapped to it"
        },
        {
          "name": "lgnum",
          "type": "string",
          "required": false
        }
      ],
      "clarify": [],
      "impl": {
        "ECC": {
          "fm": "none",
          "note": "not offered on ECC: classic warehouse management is the WM module"
        },
        "S4": {
          "source": [
            "/SCWM/T300",
            "/SCWM/T300T",
            "/SCWM/TMAPWHNUM",
            "T320"
          ],
          "note": "warehouse texts in the logon language; plants via ERP warehouse mapping and T320"
        }
      },
      "auth": [
        {
          "object": "/SCWM/MO",
          "fields": {
            "/SCWM/LGNU": "<warehouse>"
          },
          "note": "or /SCWM/DLV2 for the warehouse number (either one is enough; other fields DUMMY)"
        }
      ],
      "verified_on": [
        {
          "alias": "S4-DEV",
          "family": "S4",
          "release": "816",
          "date": "2026-11-11",
          "level": "scenario",
          "evidence": "configs/EWM/actions-evidence/S4-DEV.txt"
        }
      ]
    },
    {
