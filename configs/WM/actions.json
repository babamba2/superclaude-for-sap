    {
      "id": "WM.TO.CREATE_FOR_DLV",
      "object": "Transfer order",
      "kind": "write",
      "risk": "medium",
      "title": "Create the picking transfer order of an outbound delivery (LT03)",
      "intents": {
        "en": [
          "create TO for delivery",
          "create picking transfer order",
          "LT03"
        ],
        "ko": [
          "납품 이전오더 생성",
          "피킹 TO 생성",
          "출고 TO 생성"
        ]
      },
      "params": [
        {
          "name": "lgnum",
          "type": "string",
          "required": true
        },
        {
          "name": "vbeln",
          "type": "string",
          "required": true
        }
      ],
      "clarify": [],
      "impl": {
        "ECC": {
          "fm": "L_TO_CREATE_DN",
          "group": "L03B",
          "set": "I_LGNUM, I_VBELN, I_COMMIT_WORK = X",
          "testrun": "none",
          "preview": "checks only: delivery outbound, items of this warehouse (LIPS-LGNUM), WM status (VBUK-LVSTK) not complete, goods issue not posted, warehouse stock (LQUA, interim types 9xx left out) against the item quantity, authorization",
          "commit": "I_COMMIT_WORK = X",
          "return": "E_TANUM, E_TEILK (partial) + exceptions (DN_COMPLETED, NO_TO_CREATED, ...)",
          "note": "the TO is read back from LTAK / LTAP after the commit"
        },
        "S4": {
          "fm": "none",
          "testrun": "none",
          "preview": "refused: classic WM actions are not offered on S/4HANA (warehouse = EWM, out of scope)",
          "commit": "none",
          "note": "not offered on S/4HANA"
        }
      },
      "auth": [
        {
          "object": "L_LGNUM",
          "fields": {
            "LGNUM": "<warehouse>",
            "LGTYP": "<storage type or DUMMY>"
          }
        }
      ],
      "reverse": "WM.TO.CANCEL",
      "verified_on": [
        {
          "alias": "ECC740-DEV",
          "family": "ECC",
          "release": "740",
          "date": "2026-11-10",
          "level": "scenario",
          "evidence": "configs/WM/actions-evidence/ECC740-DEV.txt"
        }
      ],
      "preview_limits": {
        "en": [
          "The WM function module has no test mode: the preview checks status, bins, stock and authorization only.",
          "Stock and bins can change between preview and execute; the function module decides at execute."
        ],
        "ko": [
          "WM 함수 모듈에 테스트 모드가 없어서 미리보기는 상태, 저장빈, 재고, 권한만 확인해요.",
          "미리보기와 실행 사이에 재고나 저장빈이 바뀔 수 있어요. 실행할 때 함수 모듈이 최종 판단해요."
        ]
      }
    },
    {
      "id": "WM.TO.CREATE_STOCK",
      "object": "Transfer order",
      "kind": "write",
