          "name": "quantity",
          "type": "string",
          "required": true
        },
        {
          "name": "unit",
          "type": "string",
          "required": false,
          "description": "default: base unit of the material"
        },
        {
          "name": "src_lgtyp",
          "type": "string",
          "required": false
        },
        {
          "name": "src_lgpla",
          "type": "string",
          "required": false
        },
        {
          "name": "dst_lgtyp",
          "type": "string",
          "required": false
        },
        {
          "name": "dst_lgpla",
          "type": "string",
          "required": false
        }
      ],
      "clarify": [
        {
          "param": "bwlvs",
          "ask": "Which WM movement type (for a bin-to-bin move usually 999)?",
          "when": "bwlvs is missing"
        },
        {
          "param": "dst_lgpla",
          "ask": "To which destination storage type and bin?",
          "when": "dst_lgtyp or dst_lgpla is missing and the movement type does not determine it"
        }
      ],
      "impl": {
        "ECC": {
          "fm": "L_TO_CREATE_SINGLE",
          "group": "L03B",
          "set": "I_LGNUM, I_BWLVS, I_MATNR, I_WERKS, I_LGORT, I_CHARG, I_ANFME, I_ALTME, I_VLTYP / I_VLPLA, I_NLTYP / I_NLPLA, I_COMMIT_WORK = X",
          "testrun": "none",
          "preview": "checks only: movement type in T333, material in the warehouse (MLGN), source bin stock (LQUA available quantity) and removal block, destination bin exists in this warehouse, putaway block and inventory flag (LAGP), authorization for both storage types and the movement type",
          "commit": "I_COMMIT_WORK = X",
          "return": "E_TANUM, E_LTAP + exceptions",
          "note": "BAPI_WHSE_TO_CREATE_STOCK is the released alternative; L_TO_CREATE_SINGLE was verified on an ECC 7.40 DEV system"
        },
        "S4": {
          "fm": "none",
          "testrun": "none",
          "preview": "refused: classic WM actions are not offered on S/4HANA (warehouse = EWM, out of scope)",
          "commit": "none",
          "note": "not offered on S/4HANA"
        }
      },
      "auth": [
        {
          "object": "L_LGNUM",
          "fields": {
            "LGNUM": "<warehouse>",
            "LGTYP": "<source and destination storage type>"
          }
        },
        {
          "object": "L_BWLVS",
          "fields": {
            "LGNUM": "<warehouse>",
            "BWLVS": "<WM movement type>"
          }
        }
      ],
      "reverse": "WM.TO.CANCEL",
      "verified_on": [
        {
          "alias": "ECC740-DEV",
          "family": "ECC",
          "release": "740",
          "date": "2026-11-10",
          "level": "scenario",
          "evidence": "configs/WM/actions-evidence/ECC740-DEV.txt"
        }
