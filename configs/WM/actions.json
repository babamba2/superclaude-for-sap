      "id": "WM.TR.CREATE",
      "object": "Transfer requirement",
      "kind": "write",
      "risk": "medium",
      "title": "Create a transfer requirement manually (LB01)",
      "intents": {
        "en": [
          "create transfer requirement",
          "request stock movement in the warehouse",
          "LB01"
        ],
        "ko": [
          "이전요청 생성",
          "TR 생성"
        ]
      },
      "params": [
        {
          "name": "lgnum",
          "type": "string",
          "required": true
        },
        {
          "name": "bwlvs",
          "type": "string",
          "required": true
        },
        {
          "name": "matnr",
          "type": "string",
          "required": true
        },
        {
          "name": "werks",
          "type": "string",
          "required": true
        },
        {
          "name": "lgort",
          "type": "string",
          "required": false
        },
        {
          "name": "quantity",
          "type": "string",
          "required": true
        },
        {
          "name": "unit",
          "type": "string",
          "required": false
        }
      ],
      "clarify": [
        {
          "param": "bwlvs",
          "ask": "Which WM movement type for the transfer requirement?",
          "when": "bwlvs is missing"
        }
      ],
      "impl": {
        "ECC": {
          "fm": "L_TR_CREATE",
          "group": "L02B",
          "set": "T_LTBA (LGNUM, BWLVS, MATNR, WERKS, LGORT, MENGA, ALTME), I_COMMIT_WORK = X",
          "testrun": "L_TR_CREATE_CHECK (I_NUMBER = space)",
          "preview": "L_TR_CREATE_CHECK on the same T_LTBA row (check only, no number) followed by rollback, plus movement type (T333), material in the warehouse (MLGN) and authorization",
          "commit": "I_COMMIT_WORK = X",
          "return": "T_LTBA-TBNUM + LMESS / EPROT of the row"
        },
        "S4": {
          "fm": "none",
          "testrun": "none",
          "preview": "refused: classic WM actions are not offered on S/4HANA (warehouse = EWM, out of scope)",
          "commit": "none",
          "note": "not offered on S/4HANA"
        }
      },
      "auth": [
        {
          "object": "L_LGNUM",
          "fields": {
            "LGNUM": "<warehouse>",
            "LGTYP": "<storage type or DUMMY>"
          }
        },
        {
          "object": "L_BWLVS",
          "fields": {
            "LGNUM": "<warehouse>",
            "BWLVS": "<WM movement type>"
          }
        }
      ],
