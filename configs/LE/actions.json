    {
      "id": "LE.SHP.CREATE",
      "object": "Shipment",
      "kind": "write",
      "risk": "medium",
      "title": "Create a shipment for one or more deliveries",
      "intents": {
        "en": [
          "create shipment",
          "make a shipment for these deliveries",
          "plan transport"
        ],
        "ko": [
          "운송 생성",
          "선적 생성",
          "이 납품으로 운송 만들어"
        ]
      },
      "params": [
        {
          "name": "shtyp",
          "type": "string",
          "required": true
        },
        {
          "name": "tplst",
          "type": "string",
          "required": true
        },
        {
          "name": "dlv_list",
          "type": "string[]",
          "required": true,
          "description": "delivery numbers"
        },
        {
          "name": "route",
          "type": "string",
          "required": false
        },
        {
          "name": "tdlnr",
          "type": "string",
          "required": false,
          "description": "carrier vendor number"
        },
        {
          "name": "exti1",
          "type": "string",
          "required": false
        },
        {
          "name": "exti2",
          "type": "string",
          "required": false
        }
      ],
      "clarify": [
        {
          "param": "shtyp",
          "ask": "Which shipment type?",
          "when": "shtyp is missing"
        },
        {
          "param": "tplst",
          "ask": "Which transportation planning point?",
          "when": "tplst is missing"
        },
        {
          "param": "dlv_list",
          "ask": "Which deliveries go into the shipment?",
          "when": "dlv_list is missing"
        }
      ],
      "impl": {
        "ECC": {
          "fm": "BAPI_SHIPMENT_CREATE",
          "group": "V56I_BAPI",
          "set": "HEADERDATA (SHIPMENT_TYPE, TRANS_PLAN_PT, SHIPMENT_ROUTE, SERVICE_AGENT_ID, EXTERNAL_ID_1/2), ITEMDATA (DELIVERY, ITENERARY)",
          "testrun": "none",
          "preview": "rule check only: shipment type (TVTK), planning point (TTDS), route (TVRO), carrier (vendor exists), every delivery outbound / transport relevant / not planned completely, authorization; nothing is called",
          "commit": "BAPI_TRANSACTION_COMMIT WAIT",
          "return": "RETURN (BAPIRET2) + TRANSPORT number"
        },
        "S4": {
          "fm": "none",
          "testrun": "none",
          "preview": "refused: not available on S/4HANA (transportation runs in SAP TM)",
          "commit": "none",
          "note": "not available on S/4HANA: shipments, shipment costs and packing run in SAP TM / EWM there"
        }
      },
      "auth": [
        {
          "object": "V_VTTK_SHT",
          "fields": {
            "SHTYP": "<shipment type>",
            "ACTVT": "01"
          }
        },
        {
          "object": "V_VTTK_TDS",
          "fields": {
            "TPLST": "<transportation planning point>",
            "ACTVT": "01"
          }
        },
        {
          "object": "V_LIKP_VST",
          "fields": {
            "VSTEL": "<shipping point>",
            "ACTVT": "02"
          }
        }
      ],
      "preview_limits": {
        "en": [
          "The shipment BAPI has no test mode: errors raised only at save (number range, shipment type rules, user exits) appear at execute."
        ],
        "ko": [
          "운송 BAPI에는 테스트 모드가 없어요. 저장할 때만 나는 오류(번호 범위, 운송 유형 규칙, 사용자 출구)는 실행할 때 나와요."
        ]
      },
      "verified_on": [
        {
          "alias": "ECC740-DEV",
          "family": "ECC",
          "release": "740",
          "date": "2026-11-10",
          "level": "scenario",
          "evidence": "configs/LE/actions-evidence/ECC740-DEV.txt"
        }
      ]
    },
