{
  "schemaVersion": 1,
  "module": "LE",
  "area": "shipments, picking, packing / handling units, delivery changes, shipment costs (LE-TRA)",
  "notes": [
    "Business actions for /sc4sap:assist, executed only through ZMCP_BIZ_EXECUTE on the SAP side (handler ZCL_MCP_BIZ_LE).",
    "ECC only. On S/4HANA transportation runs in SAP TM (and warehouse handling in EWM): every LE action is refused there.",
    "Outbound delivery creation, goods issue and its reversal stay in SD (SD.DLV.*); LE covers shipments, shipment costs, picking, packing and delivery changes.",
    "BAPI_SHIPMENT_CHANGE saves by itself (proven on the test system: a change persisted after ROLLBACK WORK), so shipment change and status previews are rule checks only.",
    "Picking, delivery changes and packing preview with WS_DELIVERY_UPDATE_2 in check mode (IF_DATABASE_UPDATE_1 = 2), then rollback.",
    "Not offered: shipment deletion, shipment cost creation and settlement (VI01 / VI02 runs), inbound deliveries, collective shipment creation (VT04).",
    "The carrier is shown as its vendor number only; no partner names or addresses are returned."
  ],
  "actions": [
    {
      "id": "LE.SHP.LIST",
      "object": "Shipment",
      "kind": "query",
      "risk": "none",
      "title": "List shipments of a transportation planning point",
      "intents": {
        "en": [
          "shipments planned today",
          "open shipments",
          "shipments not started",
          "list shipments"
        ],
        "ko": [
          "오늘 출발 운송",
          "미출발 운송",
          "운송 목록",
          "선적 목록"
        ]
      },
      "params": [
        {
          "name": "tplst",
          "type": "string",
          "required": true
        },
        {
          "name": "shtyp",
          "type": "string",
          "required": false
        },
        {
          "name": "status",
          "type": "string",
          "required": false,
          "values": [
            "not_started",
            "started",
            "completed",
            "all"
          ]
        },
        {
          "name": "date_basis",
          "type": "string",
          "required": false,
          "values": [
            "start_today",
            "start_overdue",
            "created_last_30",
            "all"
          ]
        },
        {
          "name": "max_rows",
          "type": "string",
          "required": false
        }
      ],
      "clarify": [
        {
          "param": "tplst",
          "ask": "Which transportation planning point?",
          "when": "tplst is missing"
        }
      ],
      "impl": {
        "ECC": {
          "source": [
            "VTTK",
            "VTTP"
          ],
          "note": "SELECT on VTTK by planning point, status (STTRG) and planned start (DPTBG); no shipment list BAPI"
        },
        "S4": {
          "source": [
            "none"
          ],
          "note": "not available on S/4HANA: transportation runs in SAP TM"
        }
      },
      "auth": [
        {
          "object": "V_VTTK_SHT",
          "fields": {
            "SHTYP": "<shipment type>",
            "ACTVT": "03"
          }
        },
        {
          "object": "V_VTTK_TDS",
          "fields": {
            "TPLST": "<transportation planning point>",
            "ACTVT": "03"
