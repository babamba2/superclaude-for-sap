          { "id": "CO.4.2.2", "label": { "en": "Internal order reports", "ko": "내부오더 보고서", "ja": "内部指図レポート" },
            "tcodes": ["KOB1", "S_ALR_87012993", "KO03"], "tables": ["AUFK", "COEP", "COSP", "COSS"] }
        ] }
