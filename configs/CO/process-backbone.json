          { "id": "CO.3.2.1", "label": { "en": "Cost center actual / plan reports", "ko": "코스트센터 계획/실적 보고서", "ja": "原価センタ計画・実績レポート" },
            "tcodes": ["KSB1", "S_ALR_87013611", "S_ALR_87013612", "KSBP"], "bapis": ["BAPI_COSTCENTER_GETLIST1"], "tables": ["COEP", "COSP", "COSS", "CSKS"],
