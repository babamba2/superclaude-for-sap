        ] },
        { "id": "CO.5.3", "label": { "en": "Actual costing / material ledger", "ko": "실제원가/자재원장", "ja": "実際原価計算・品目元帳" }, "children": [
          { "id": "CO.5.3.1", "label": { "en": "Material ledger closing (actual costing run)", "ko": "자재원장 마감(실제원가 계산)", "ja": "品目元帳締め(実際原価計算)" },
            "tcodes": ["CKMLCP", "CKMLCPAVR", "CKMLQS"], "tables": ["CKMLHD", "CKMLPP", "CKMLCR", "CKMLKEPH", "MLDOC"],
            "s4": "Material ledger is mandatory; actual costing writes MLDOC / ACDOCA; CKMLCPAVR for alternative valuation runs." },
