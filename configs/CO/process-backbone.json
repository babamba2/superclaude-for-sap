          { "id": "CO.6.1.1", "label": { "en": "Line item posting and transfer from SD / FI", "ko": "SD/FI 실적 전송", "ja": "SD・FI実績転送" },
            "tcodes": ["KE21N", "KE4S", "KE27"], "bapis": ["BAPI_COPAACTUALS_POSTCOSTDATA", "BAPI_COPAACTUALS_POSTSALESDATA"], "tables": ["CE1XXXX", "CE4XXXX", "CE3XXXX"], "modules": ["SD", "FI"],
            "s4": "Account-based CO-PA (margin analysis) on ACDOCA is the default; costing-based CE1xxxx is optional." },
          { "id": "CO.6.1.2", "label": { "en": "Top-down distribution and periodic valuation", "ko": "탑다운 배분/기간 평가", "ja": "トップダウン配分・期間評価" },
            "tcodes": ["KE28", "KE40"], "tables": ["CE1XXXX", "CE3XXXX"] }
        ] },
        { "id": "CO.6.2", "label": { "en": "CO-PA planning and reporting", "ko": "CO-PA 계획/보고", "ja": "CO-PA計画・レポート" }, "children": [
          { "id": "CO.6.2.1", "label": { "en": "Sales and profit planning", "ko": "판매/이익 계획", "ja": "販売・利益計画" },
            "tcodes": ["KEPM", "KE1F"], "bapis": ["BAPI_COPAPLANNING_POSTDATA"], "tables": ["CE1XXXX", "CE3XXXX"],
            "s4": "Planning moves to SAP Analytics Cloud / ACDOCP." },
          { "id": "CO.6.2.2", "label": { "en": "Profitability reports", "ko": "수익성 보고서", "ja": "収益性レポート" },
            "tcodes": ["KE30", "KE24", "KE80"], "bapis": ["BAPI_COPAQUERY_GETCOST_ACTDATA"], "tables": ["CE1XXXX", "CE4XXXX", "ACDOCA"],
            "s4": "Fiori Product / Market Segment Profitability on ACDOCA." }
        ] }
      ] },
      { "id": "CO.7", "label": { "en": "Period-end closing", "ko": "관리회계 마감", "ja": "管理会計締め" }, "children": [
        { "id": "CO.7.1", "label": { "en": "Allocations", "ko": "배부", "ja": "配賦" }, "children": [
          { "id": "CO.7.1.1", "label": { "en": "Assessment and distribution cycles", "ko": "배부/분배 사이클", "ja": "配賦・配分サイクル" },
            "tcodes": ["KSU5", "KSV5", "KSU1", "KSV1", "KEU5"], "tables": ["T811C", "T811S", "COEP", "COSS"],
            "s4": "Fiori Manage Allocations; distribution and assessment post to ACDOCA." },
          { "id": "CO.7.1.2", "label": { "en": "Periodic reposting and indirect activity allocation", "ko": "주기적 재전기/간접 활동배부", "ja": "定期振替・間接活動配分" },
            "tcodes": ["KSW5", "KSC5", "KSII"], "tables": ["T811C", "COEP", "COST"] }
        ] },
        { "id": "CO.7.2", "label": { "en": "Closing activities", "ko": "마감 작업", "ja": "締め作業" }, "children": [
          { "id": "CO.7.2.1", "label": { "en": "Open / close CO periods", "ko": "CO 기간 오픈/마감", "ja": "CO期間オープン・クローズ" },
            "tcodes": ["OKP1", "KP90"], "tables": ["TKA01", "COPE"] },
          { "id": "CO.7.2.2", "label": { "en": "Reconciliation ledger and FI-CO reconciliation", "ko": "FI-CO 대사", "ja": "FI-CO照合" },
            "tcodes": ["KALC", "KAL1"], "tables": ["COFIS", "COEP", "BSEG"], "modules": ["FI"],
            "s4": "Real-time FI-CO integration in ACDOCA; the reconciliation ledger (KALC) is obsolete." },
          { "id": "CO.7.2.3", "label": { "en": "Profit center closing and balance transfer", "ko": "손익센터 마감/잔액 이전", "ja": "利益センタ締め・残高転送" },
            "tcodes": ["1KEK", "1KEI", "2KES", "KE5T"], "tables": ["GLPCA", "GLPCT", "CEPC"], "modules": ["FI"],
            "s4": "1KEK / 1KEI obsolete; balance sheet items carry profit center from document splitting in ACDOCA." }
        ] }
      ] }
    ] }
