          { "id": "CO.2.1.1", "label": { "en": "Plan costs and activity quantities", "ko": "원가/활동량 계획", "ja": "原価・活動数量計画" },
            "tcodes": ["KP06", "KP26", "KP46", "KPF6"], "bapis": ["BAPI_COSTACTPLN_POSTPRIMCOST", "BAPI_COSTACTPLN_POSTACTOUTPUT"], "tables": ["COSP", "COSS", "COST", "COKP"],
            "s4": "Planning moves to SAP Analytics Cloud / BPC optimized for S/4HANA (ACDOCP); classic KP06 remains as an option." },
          { "id": "CO.2.1.2", "label": { "en": "Plan activity price calculation", "ko": "활동단가 계획 계산", "ja": "活動単価計画計算" },
            "tcodes": ["KSPI", "KP26"], "tables": ["COST", "CSSL"] }
