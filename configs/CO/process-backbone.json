{
  "schema": 1,
  "module": "CO",
  "note": "Standard SAP CO process backbone (generic, no customer content). L1 mega process > L2 process chain > L3 process > L4 task. tcodes/bapis/tables are anchors used to attach CBO objects; ecc/s4 lists only differences. CE1xxxx / CE4xxxx stand for the operating-concern tables (xxxx = operating concern).",
  "tree": [
    { "id": "CO", "label": { "en": "Controlling", "ko": "관리회계", "ja": "管理会計" }, "children": [
      { "id": "CO.1", "label": { "en": "Master data", "ko": "관리회계 기준정보", "ja": "管理会計マスタ" }, "children": [
        { "id": "CO.1.1", "label": { "en": "Cost element accounting", "ko": "원가요소 회계", "ja": "原価要素会計" }, "children": [
          { "id": "CO.1.1.1", "label": { "en": "Create / change cost element", "ko": "원가요소 생성/변경", "ja": "原価要素登録・変更" },
            "tcodes": ["KA01", "KA02", "KA06", "FS00"], "bapis": ["BAPI_COSTELEM_CREATEMULTIPLE", "K_COSTELEM_BAPI_CREATE"], "tables": ["CSKA", "CSKB", "CSKU", "SKA1"],
            "s4": "Cost elements are G/L accounts (FS00, G/L account type + cost element category); CSKA / CSKB are compatibility views." },
          { "id": "CO.1.1.2", "label": { "en": "Cost element groups", "ko": "원가요소 그룹", "ja": "原価要素グループ" },
            "tcodes": ["KAH1", "KAH2"], "tables": ["SETHEADER", "SETNODE", "SETLEAF"] }
        ] },
        { "id": "CO.1.2", "label": { "en": "Cost center and activity type", "ko": "코스트센터/활동유형", "ja": "原価センタ・活動タイプ" }, "children": [
          { "id": "CO.1.2.1", "label": { "en": "Create / change cost center", "ko": "코스트센터 생성/변경", "ja": "原価センタ登録・変更" },
            "tcodes": ["KS01", "KS02", "KS12", "KCH1", "OKEON"], "bapis": ["BAPI_COSTCENTER_CREATEMULTIPLE", "BAPI_COSTCENTER_CHANGEMULTIPLE"], "tables": ["CSKS", "CSKT", "SETHEADER"] },
          { "id": "CO.1.2.2", "label": { "en": "Activity types and statistical key figures", "ko": "활동유형/통계지표", "ja": "活動タイプ・統計キー数値" },
            "tcodes": ["KL01", "KL02", "KK01"], "bapis": ["BAPI_ACTTYPE_CREATEMULTIPLE"], "tables": ["CSLA", "CSLT", "TKA03"] }
        ] },
        { "id": "CO.1.3", "label": { "en": "Profit center", "ko": "손익센터", "ja": "利益センタ" }, "children": [
          { "id": "CO.1.3.1", "label": { "en": "Create / change profit center", "ko": "손익센터 생성/변경", "ja": "利益センタ登録・変更" },
            "tcodes": ["KE51", "KE52", "KCH1", "KE56"], "bapis": ["BAPI_PROFITCENTER_CREATE", "BAPI_PROFITCENTER_CHANGE"], "tables": ["CEPC", "CEPCT", "CEPC_BUKRS"],
            "s4": "Profit center accounting is part of the universal journal (PRCTR in ACDOCA); classic EC-PCA tables GLPCA / GLPCT are not updated." }
        ] }
      ] },
