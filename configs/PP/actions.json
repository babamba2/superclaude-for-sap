{
  "schemaVersion": 1,
  "module": "PP",
  "area": "production orders",
  "notes": [
    "Business actions for /sc4sap:assist, executed only through ZMCP_BIZ_EXECUTE on the SAP side.",
    "Draft 2026-11-09: interface checked on ECC740-DEV only; S4-DEV and ECC731-DEV pending.",
    "Actions without TESTRUN are previewed from order status, configuration and the customer check rules of the system (biz-rules/PP.json)."
  ],
  "actions": [
    {
      "id": "PP.ORD.LIST_OPEN",
      "object": "ProductionOrder",
      "kind": "query",
      "risk": "none",
      "title": "List open production orders",
      "intents": {
        "en": [
          "open production orders",
          "orders to release",
          "orders due"
        ],
        "ko": [
          "미결 생산오더",
          "릴리스할 오더",
          "납기 생산오더"
        ]
      },
      "params": [
        {
          "name": "werks",
          "type": "string",
          "required": true
        },
        {
          "name": "status",
          "type": "string",
          "required": true,
          "values": [
            "created",
            "released",
            "all_open"
          ]
        },
        {
          "name": "date_basis",
          "type": "string",
          "required": true,
          "values": [
            "start_due_today",
            "start_overdue_until_today",
            "all"
          ]
        },
        {
          "name": "dispo",
          "type": "string",
          "required": false
        },
        {
          "name": "matnr",
          "type": "string",
          "required": false
        },
        {
          "name": "max_rows",
          "type": "string",
          "required": false
        }
      ],
      "clarify": [
        {
          "param": "status",
          "ask": "Only orders not released yet, only released orders, or all open orders?",
          "when": "status is missing"
        },
        {
          "param": "date_basis",
          "ask": "Orders that start today, orders whose start date has passed, or all?",
          "when": "date_basis is missing"
        },
        {
          "param": "werks",
          "ask": "Which plant?",
          "when": "werks is missing"
        }
      ],
      "impl": {
        "ECC": {
          "fm": "BAPI_PRODORD_GET_LIST",
          "group": "2005_BAPI",
          "return": "BAPIRET2",
          "note": "or SELECT AFKO/AUFK/JEST (status filter, M_... auth by plant)"
        },
        "S4": {
          "fm": "BAPI_PRODORD_GET_LIST",
          "group": "2005_BAPI",
          "return": "BAPIRET2",
          "note": "or SELECT AFKO/AUFK/JEST (status filter, M_... auth by plant)"
        }
      },
      "auth": [
        {
          "object": "C_AFKO_AWK",
          "fields": {
            "WERKS": "<plant>",
            "AUFART": "<order type>"
          }
        }
      ],
      "verified_on": [
        {
          "alias": "ECC740-DEV",
          "family": "ECC",
          "release": "740",
          "date": "2026-11-09",
          "level": "interface",
          "evidence": "configs/PP/actions-evidence/ECC740-DEV.txt"
        },
        {
          "alias": "S4-DEV",
          "family": "S4",
          "release": "816",
          "date": "2026-11-10",
          "level": "handler",
          "evidence": "configs/PP/actions-evidence/S4-DEV.txt"
        },
        {
          "alias": "S4-DEV",
          "family": "S4",
          "release": "816",
          "date": "2026-11-10",
          "level": "scenario",
          "evidence": "configs/PP/actions-evidence/S4-DEV-scenarios.txt"
        }
      ]
