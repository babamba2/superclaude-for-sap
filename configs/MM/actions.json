{
  "schemaVersion": 1,
  "module": "MM",
  "area": "purchasing",
  "notes": [
    "Business actions for /sc4sap:assist. Executed only through ZMCP_BIZ_EXECUTE on the SAP side.",
    "An action is shown to the user only when verified_on is not empty for the connected system family (ECC or S4).",
    "Business-meaning questions have no defaults: the skill asks them (clarify). Technical rules are fixed (rules).",
    "S4 handlers fill and read MATERIAL_LONG (CHAR 40) in BAPI structures; ECC handlers use MATERIAL (CHAR 18). Verified 2026-11-09.",
    "BAPI_PO_RELEASE / BAPI_PO_RESET_RELEASE return BAPIRETURN (not BAPIRET2), raise classic exceptions and have no TESTRUN. Handlers map BAPIRETURN to the common result shape."
  ],
  "actions": [
    {
      "id": "MM.PO.LIST_OPEN",
      "object": "PurchaseOrder",
      "kind": "query",
      "risk": "none",
      "title": "List open purchase order items",
      "intents": {
        "en": [
          "open purchase orders",
          "open POs",
          "POs not yet received"
        ],
        "ko": [
          "미결 구매오더",
          "미결 PO",
          "입고 안 된 PO",
          "미입고"
        ]
      },
      "params": [
        {
          "name": "date_basis",
          "type": "enum",
          "values": [
            "due_today",
            "overdue_until_today",
            "all_open"
          ],
          "required": true
        },
        {
          "name": "ekgrp",
          "type": "string",
          "required": false,
          "description": "Purchasing group"
        },
        {
          "name": "lifnr",
          "type": "string",
          "required": false,
          "description": "Vendor"
        },
        {
          "name": "werks",
          "type": "string",
          "required": false,
          "description": "Plant"
        },
        {
          "name": "include_unreleased",
          "type": "boolean",
          "required": true
        },
        {
          "name": "max_rows",
          "type": "integer",
          "required": false,
          "default": 200
        }
      ],
      "clarify": [
        {
          "param": "date_basis",
          "ask": "Which open items: only those due today, everything due up to today, or every open item?",
          "options": [
            "due_today",
            "overdue_until_today",
            "all_open"
          ]
        },
        {
          "param": "scope",
          "ask": "Whose orders: your purchasing group only, or a specific vendor or plant?",
          "when": "ekgrp, lifnr and werks are all missing"
        },
        {
          "param": "include_unreleased",
          "ask": "Include orders that are not released yet?",
          "options": [
            true,
            false
          ]
        }
      ],
      "rules": [
        "open quantity = EKET-MENGE - EKET-WEMNG > 0",
        "exclude EKPO-LOEKZ <> space and EKPO-ELIKZ = 'X'",
        "exclude EKKO-LOEKZ <> space",
        "only EKKO-BSTYP = 'F' (purchase orders)",
        "date_basis due_today: EKET-EINDT = today; overdue_until_today: EKET-EINDT <= today",
        "include_unreleased = false: EKKO-FRGKE must be released or no release strategy (FRGZU complete or FRGKE space)"
      ],
      "impl": {
        "ECC": {
          "source": [
            "EKKO",
            "EKPO",
            "EKET"
          ],
          "method": "select"
        },
        "S4": {
          "source": [
            "EKKO",
            "EKPO",
            "EKET"
          ],
          "method": "select",
          "later": "released CDS I_PurchaseOrderItemAPI01 (deferred with released APIs)"
        }
      },
      "auth": [
        {
          "object": "M_BEST_EKG",
          "fields": {
            "ACTVT": "03",
            "EKGRP": "<row>"
          }
        }
      ],
      "verified_on": [
        {
          "alias": "ECC740-DEV",
          "family": "ECC",
          "release": "740",
          "date": "2026-11-09",
          "level": "interface",
          "evidence": "configs/MM/actions-evidence/ECC740-DEV.txt"
        },
        {
          "alias": "S4-DEV",
          "family": "S4",
          "release": "816",
          "date": "2026-11-09",
          "level": "interface",
          "evidence": "configs/MM/actions-evidence/S4-DEV.txt"
        },
        {
          "alias": "ECC731-DEV",
          "family": "ECC",
          "release": "731",
          "date": "2026-11-09",
          "level": "interface",
          "evidence": "configs/MM/actions-evidence/ECC731-DEV.txt"
        }
      ]
    },
