    {
      "id": "MM.PO.CHANGE_QUANTITY",
      "object": "PurchaseOrder",
      "kind": "write",
      "risk": "medium",
      "title": "Change the order quantity of a PO item",
      "intents": {
        "en": [
          "change PO quantity"
        ],
        "ko": [
          "수량 변경",
          "발주 수량 변경"
        ]
      },
      "params": [
        {
          "name": "ebeln",
          "type": "string",
          "required": true
        },
        {
          "name": "ebelp",
          "type": "string[]",
          "required": true
        },
        {
          "name": "new_quantity",
          "type": "number",
          "required": true
        },
        {
          "name": "cbo",
          "type": "string[]",
          "required": false,
          "format": "H.<FIELD>=<value> | I.<ebelp>.<FIELD>=<value>; dates YYYY-MM-DD, numbers with . as decimal separator"
        }
      ],
      "rules": [
        "new_quantity must not be below the quantity already received (POHISTORY_TOTALS)"
      ],
