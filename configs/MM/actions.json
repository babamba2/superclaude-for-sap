    {
      "id": "MM.PO.SET_DELIVERY_COMPLETE",
      "object": "PurchaseOrder",
      "kind": "write",
      "risk": "medium",
      "title": "Set the delivery-completed indicator on PO items",
      "intents": {
        "en": [
          "close PO",
          "delivery complete",
          "no more goods receipt"
        ],
        "ko": [
          "완결",
          "납품 완료",
          "더 이상 입고 없음"
        ]
      },
      "ambiguity": {
        "term": {
          "en": "close",
          "ko": "완결"
        },
        "candidates": [
          "MM.PO.SET_DELIVERY_COMPLETE",
          "MM.PO.SET_FINAL_INVOICE",
          "MM.PO.DELETE_ITEM"
        ],
        "ask": "By 'close', do you mean no more goods receipts (delivery completed), no more invoices (final invoice), or deleting the item?"
      },
      "params": [
        {
          "name": "ebeln",
          "type": "string",
          "required": true
        },
        {
          "name": "ebelp",
          "type": "string[]",
          "required": false
        },
        {
          "name": "cbo",
          "type": "string[]",
          "required": false,
          "format": "H.<FIELD>=<value> | I.<ebelp>.<FIELD>=<value>; dates YYYY-MM-DD, numbers with . as decimal separator"
        }
      ],
      "clarify": [
        {
          "param": "ebelp",
          "ask": "All items of this order, or only some items?",
          "when": "ebelp is missing and the order has more than one open item"
        },
        {
          "param": "cbo",
          "ask": "This PO has customer fields (cbo_fields in the preview). Must any of them change together with this action?",
          "when": "the PREVIEW result lists cbo_fields; ask once, before EXECUTE; fields with settable=false can only be shown (explain the note)"
        }
      ],
      "impl": {
        "ECC": {
          "fm": "BAPI_PO_CHANGE",
          "group": "2012",
          "set": "POITEM-NO_MORE_GR = 'X', POITEMX-NO_MORE_GR = 'X'",
          "testrun": "TESTRUN",
          "commit": "BAPI_TRANSACTION_COMMIT",
          "return": "BAPIRET2"
        },
        "S4": {
          "fm": "BAPI_PO_CHANGE",
          "group": "2012",
          "set": "POITEM-NO_MORE_GR = 'X', POITEMX-NO_MORE_GR = 'X'",
          "testrun": "TESTRUN",
          "commit": "BAPI_TRANSACTION_COMMIT",
          "return": "BAPIRET2"
        }
      },
      "auth": [
        {
          "object": "M_BEST_EKO",
          "fields": {
            "ACTVT": "02"
          }
        }
      ],
      "reverse": "MM.PO.UNSET_DELIVERY_COMPLETE",
      "verified_on": [
        {
          "alias": "ECC740-DEV",
          "family": "ECC",
          "release": "740",
          "date": "2026-11-09",
          "level": "interface",
