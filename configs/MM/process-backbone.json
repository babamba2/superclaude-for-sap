{
  "schema": 1,
  "module": "MM",
  "note": "Standard SAP MM process backbone (generic, no customer content). L1 mega process > L2 process chain > L3 process > L4 task. tcodes/bapis/tables are anchors used to attach CBO objects; ecc/s4 lists only differences.",
  "tree": [
    { "id": "MM", "label": { "en": "Procurement and materials", "ko": "구매/자재관리", "ja": "購買・在庫管理" }, "children": [
      { "id": "MM.1", "label": { "en": "Master data", "ko": "기준정보 관리", "ja": "マスタ管理" }, "children": [
        { "id": "MM.1.1", "label": { "en": "Material master", "ko": "자재마스터", "ja": "品目マスタ" }, "children": [
          { "id": "MM.1.1.1", "label": { "en": "Create / change material", "ko": "자재 생성/변경", "ja": "品目登録・変更" },
            "tcodes": ["MM01", "MM02", "MM17"], "bapis": ["BAPI_MATERIAL_SAVEDATA"], "tables": ["MARA", "MAKT", "MARC", "MARD", "MBEW", "MVKE"] },
          { "id": "MM.1.1.2", "label": { "en": "Flag material for deletion", "ko": "자재 삭제 표시", "ja": "品目削除フラグ" },
            "tcodes": ["MM06"], "tables": ["MARA", "MARC"] }
        ] },
        { "id": "MM.1.2", "label": { "en": "Vendor master", "ko": "구매처마스터", "ja": "仕入先マスタ" }, "children": [
          { "id": "MM.1.2.1", "label": { "en": "Create / change vendor", "ko": "구매처 생성/변경", "ja": "仕入先登録・変更" },
            "tcodes": ["XK01", "XK02", "MK01", "MK02", "FK01", "FK02", "BP"], "bapis": ["BAPI_VENDOR_CREATE", "VENDOR_INSERT"],
            "tables": ["LFA1", "LFB1", "LFM1", "LFBK", "BUT000"], "s4": "Business Partner (BP) replaces XK01/MK01/FK01; CVI keeps LFA1 in sync." },
          { "id": "MM.1.2.2", "label": { "en": "Block / delete vendor", "ko": "구매처 보류/삭제", "ja": "仕入先ブロック・削除" },
            "tcodes": ["XK05", "XK06"], "tables": ["LFA1", "LFB1"] }
        ] },
        { "id": "MM.1.3", "label": { "en": "Purchasing info and sources", "ko": "구매정보/공급원", "ja": "購買情報・供給元" }, "children": [
          { "id": "MM.1.3.1", "label": { "en": "Maintain purchasing info record", "ko": "구매정보레코드 관리", "ja": "購買情報レコード管理" },
            "tcodes": ["ME11", "ME12", "ME13"], "tables": ["EINA", "EINE"] },
          { "id": "MM.1.3.2", "label": { "en": "Maintain source list / quota", "ko": "공급원 목록/할당 관리", "ja": "供給元一覧・割当" },
            "tcodes": ["ME01", "MEQ1"], "tables": ["EORD", "EQUK", "EQUP"] },
          { "id": "MM.1.3.3", "label": { "en": "Maintain purchasing conditions", "ko": "구매 조건 관리", "ja": "購買条件管理" },
            "tcodes": ["MEK1", "MEK2", "MEK3"], "bapis": ["BAPI_PRICES_CONDITIONS"], "tables": ["KONH", "KONP"] }
        ] },
        { "id": "MM.1.4", "label": { "en": "Outline agreements", "ko": "기본계약", "ja": "基本契約" }, "children": [
          { "id": "MM.1.4.1", "label": { "en": "Create / change contract", "ko": "계약 생성/변경", "ja": "契約登録・変更" },
            "tcodes": ["ME31K", "ME32K"], "bapis": ["BAPI_CONTRACT_CREATE"], "tables": ["EKKO", "EKPO"] },
          { "id": "MM.1.4.2", "label": { "en": "Create / change scheduling agreement", "ko": "납품일정계약 생성/변경", "ja": "分納契約登録・変更" },
            "tcodes": ["ME31L", "ME32L", "ME38"], "tables": ["EKKO", "EKPO", "EKET"] }
        ] }
      ] },
      { "id": "MM.2", "label": { "en": "Purchasing", "ko": "구매조달", "ja": "購買" }, "children": [
        { "id": "MM.2.1", "label": { "en": "Purchase requisition", "ko": "구매요청", "ja": "購買依頼" }, "children": [
          { "id": "MM.2.1.1", "label": { "en": "Create purchase requisition", "ko": "구매요청 생성", "ja": "購買依頼登録" },
            "tcodes": ["ME51N", "ME52N", "ME51"], "bapis": ["BAPI_PR_CREATE", "BAPI_REQUISITION_CREATE"], "tables": ["EBAN", "EBKN"] },
          { "id": "MM.2.1.2", "label": { "en": "Release purchase requisition", "ko": "구매요청 승인", "ja": "購買依頼承認" },
            "tcodes": ["ME54N", "ME55"], "bapis": ["BAPI_REQUISITION_RELEASE"], "tables": ["EBAN"] },
          { "id": "MM.2.1.3", "label": { "en": "Requirements from MRP", "ko": "MRP 소요량 반영", "ja": "MRP所要量" },
            "tcodes": ["MD01", "MD03", "MD04"], "tables": ["PLAF", "EBAN", "MDKP"], "modules": ["PP"] }
        ] },
        { "id": "MM.2.2", "label": { "en": "Sourcing", "ko": "견적/소싱", "ja": "見積・調達先選定" }, "children": [
          { "id": "MM.2.2.1", "label": { "en": "RFQ and quotation", "ko": "견적요청/견적", "ja": "見積依頼・見積" },
            "tcodes": ["ME41", "ME47", "ME49"], "tables": ["EKKO", "EKPO"] },
          { "id": "MM.2.2.2", "label": { "en": "Assign source of supply", "ko": "공급원 지정", "ja": "供給元割当" },
            "tcodes": ["ME56", "ME57"], "tables": ["EBAN", "EORD"] }
        ] },
        { "id": "MM.2.3", "label": { "en": "Purchase order", "ko": "구매발주", "ja": "購買発注" }, "children": [
          { "id": "MM.2.3.1", "label": { "en": "Create / change purchase order", "ko": "구매오더 생성/변경", "ja": "購買発注登録・変更" },
            "tcodes": ["ME21N", "ME22N", "ME23N", "ME59N"], "bapis": ["BAPI_PO_CREATE1", "BAPI_PO_CHANGE", "BAPI_PO_CREATE"], "tables": ["EKKO", "EKPO", "EKET", "EKKN"] },
          { "id": "MM.2.3.2", "label": { "en": "Release purchase order", "ko": "구매오더 승인", "ja": "購買発注承認" },
            "tcodes": ["ME28", "ME29N"], "bapis": ["BAPI_PO_RELEASE"], "tables": ["EKKO"] },
          { "id": "MM.2.3.3", "label": { "en": "Send purchase order (output)", "ko": "구매오더 출력/전송", "ja": "購買発注出力" },
            "tcodes": ["ME9F", "NACE"], "tables": ["NAST"], "s4": "Output management may run on BRF+ (APOC) instead of NAST." },
          { "id": "MM.2.3.4", "label": { "en": "Order acknowledgement / confirmation", "ko": "납기 회신/확인", "ja": "受注確認" },
            "tcodes": ["ME22N", "ME2A"], "tables": ["EKES"] }
        ] },
        { "id": "MM.2.4", "label": { "en": "Stock transfer and intercompany", "ko": "이고/법인간 거래", "ja": "在庫転送・会社間取引" }, "children": [
          { "id": "MM.2.4.1", "label": { "en": "Stock transport order", "ko": "재고이전오더(STO)", "ja": "在庫転送オーダ" },
            "tcodes": ["ME21N", "ME27"], "bapis": ["BAPI_PO_CREATE1"], "tables": ["EKKO", "EKPO", "EKBE"], "modules": ["SD"] },
          { "id": "MM.2.4.2", "label": { "en": "Third-party / drop shipment", "ko": "3자 직송 구매", "ja": "第三者取引購買" },
            "tcodes": ["ME21N"], "tables": ["EKKO", "EKPO", "EKKN"], "modules": ["SD"] }
        ] },
        { "id": "MM.2.5", "label": { "en": "Import purchasing", "ko": "수입 구매", "ja": "輸入購買" }, "children": [
          { "id": "MM.2.5.1", "label": { "en": "Inbound delivery / shipping notification", "ko": "입고예정(Inbound Delivery)", "ja": "入荷予定" },
            "tcodes": ["VL31N", "VL32N"], "tables": ["LIKP", "LIPS"], "modules": ["LE"] },
          { "id": "MM.2.5.2", "label": { "en": "Import costs (customs, freight)", "ko": "수입 부대비용", "ja": "輸入付随費用" },
            "tcodes": ["ME21N", "MIRO"], "tables": ["EKBZ", "KONV"], "s4": "KONV is replaced by PRCD_ELEMENTS." }
        ] }
      ] },
      { "id": "MM.3", "label": { "en": "Inventory management", "ko": "재고관리", "ja": "在庫管理" }, "children": [
        { "id": "MM.3.1", "label": { "en": "Goods receipt", "ko": "입고", "ja": "入庫" }, "children": [
          { "id": "MM.3.1.1", "label": { "en": "Goods receipt for purchase order", "ko": "구매오더 입고", "ja": "購買発注入庫" },
            "tcodes": ["MIGO", "MB01", "MIGO_GR"], "bapis": ["BAPI_GOODSMVT_CREATE"], "tables": ["MKPF", "MSEG", "MATDOC", "EKBE"],
            "s4": "MKPF/MSEG are replaced by MATDOC; MB01 and other MB* transactions are not available." },
          { "id": "MM.3.1.2", "label": { "en": "Return delivery to vendor", "ko": "구매 반품", "ja": "仕入先返品" },
            "tcodes": ["MIGO", "MBRL"], "bapis": ["BAPI_GOODSMVT_CREATE"], "tables": ["MKPF", "MSEG", "MATDOC"] },
          { "id": "MM.3.1.3", "label": { "en": "Quality inspection stock release", "ko": "품질검사 재고 해제", "ja": "品質検査在庫解除" },
            "tcodes": ["QA11", "QA32"], "tables": ["QALS", "QAVE"], "modules": ["QM"] }
        ] },
        { "id": "MM.3.2", "label": { "en": "Goods issue", "ko": "출고", "ja": "出庫" }, "children": [
          { "id": "MM.3.2.1", "label": { "en": "Goods issue to cost center / order", "ko": "코스트센터/오더 출고", "ja": "原価センタ・指図出庫" },
            "tcodes": ["MIGO", "MB1A"], "bapis": ["BAPI_GOODSMVT_CREATE"], "tables": ["MKPF", "MSEG", "MATDOC"], "modules": ["CO"] },
          { "id": "MM.3.2.2", "label": { "en": "Reservation", "ko": "예약", "ja": "予約" },
            "tcodes": ["MB21", "MB22", "MB25"], "bapis": ["BAPI_RESERVATION_CREATE1"], "tables": ["RKPF", "RESB"] }
        ] },
        { "id": "MM.3.3", "label": { "en": "Stock transfer", "ko": "재고이동", "ja": "在庫転送" }, "children": [
          { "id": "MM.3.3.1", "label": { "en": "Transfer posting (plant / storage location)", "ko": "플랜트/저장위치 간 이동", "ja": "プラント・保管場所間転送" },
            "tcodes": ["MIGO", "MB1B"], "bapis": ["BAPI_GOODSMVT_CREATE"], "tables": ["MKPF", "MSEG", "MATDOC"] },
          { "id": "MM.3.3.2", "label": { "en": "Stock type / special stock change", "ko": "재고유형/특수재고 변경", "ja": "在庫タイプ・特殊在庫変更" },
            "tcodes": ["MIGO", "MB1B"], "tables": ["MKPF", "MSEG", "MATDOC", "MSKA", "MSLB"] }
        ] },
        { "id": "MM.3.4", "label": { "en": "Physical inventory", "ko": "재고실사", "ja": "棚卸" }, "children": [
          { "id": "MM.3.4.1", "label": { "en": "Count and post differences", "ko": "실사 및 차이 전기", "ja": "棚卸・差異転記" },
            "tcodes": ["MI01", "MI04", "MI07", "MI20"], "bapis": ["BAPI_MATPHYSINV_CREATE_MULT", "BAPI_MATPHYSINV_POSTDIFF"], "tables": ["IKPF", "ISEG"] }
        ] },
        { "id": "MM.3.5", "label": { "en": "Stock reporting", "ko": "재고 조회", "ja": "在庫照会" }, "children": [
          { "id": "MM.3.5.1", "label": { "en": "Stock overview and history", "ko": "재고 현황/이력 조회", "ja": "在庫一覧・履歴" },
            "tcodes": ["MMBE", "MB52", "MB51", "MB5B", "MCBE"], "tables": ["MARD", "MCHB", "MSEG", "MATDOC", "NSDM_V_MARD"] }
        ] }
      ] },
      { "id": "MM.4", "label": { "en": "Invoice verification", "ko": "송장검증", "ja": "請求書照合" }, "children": [
        { "id": "MM.4.1", "label": { "en": "Vendor invoice", "ko": "구매 송장", "ja": "仕入先請求書" }, "children": [
          { "id": "MM.4.1.1", "label": { "en": "Enter invoice", "ko": "송장 입력", "ja": "請求書入力" },
            "tcodes": ["MIRO", "MIR7", "MIRA"], "bapis": ["BAPI_INCOMINGINVOICE_CREATE", "BAPI_INCOMINGINVOICE_CREATE1"], "tables": ["RBKP", "RSEG", "BKPF", "BSEG"], "modules": ["FI"] },
          { "id": "MM.4.1.2", "label": { "en": "Evaluated receipt settlement (ERS)", "ko": "자동 송장(ERS)", "ja": "自動請求(ERS)" },
            "tcodes": ["MRRL", "MRNB"], "tables": ["RBKP", "RSEG", "EKBE"], "modules": ["FI"] },
          { "id": "MM.4.1.3", "label": { "en": "Release blocked invoices", "ko": "보류 송장 해제", "ja": "保留請求書解除" },
            "tcodes": ["MRBR"], "tables": ["RBKP", "RSEG", "BSEG"], "modules": ["FI"] }
        ] },
        { "id": "MM.4.2", "label": { "en": "GR/IR clearing", "ko": "GR/IR 정리", "ja": "GR/IR消込" }, "children": [
          { "id": "MM.4.2.1", "label": { "en": "Maintain GR/IR clearing account", "ko": "GR/IR 계정 정리", "ja": "GR/IR勘定消込" },
            "tcodes": ["MR11", "F.13"], "tables": ["EKBE", "BSIS", "ACDOCA"], "modules": ["FI"], "s4": "Open items read from ACDOCA; BSIS is a compatibility view." }
        ] }
      ] },
      { "id": "MM.5", "label": { "en": "Valuation and period end", "ko": "평가/마감", "ja": "評価・期末処理" }, "children": [
        { "id": "MM.5.1", "label": { "en": "Period end", "ko": "기간 마감", "ja": "期間締め" }, "children": [
          { "id": "MM.5.1.1", "label": { "en": "Open next MM period", "ko": "자재 기간 오픈", "ja": "在庫期間オープン" },
            "tcodes": ["MMPV", "MMRV"], "tables": ["MARV"] },
          { "id": "MM.5.1.2", "label": { "en": "Price change / revaluation", "ko": "단가 변경/재평가", "ja": "価格変更・再評価" },
            "tcodes": ["MR21", "MR22", "CKMLCP"], "tables": ["MBEW", "CKMLHD", "CKMLCR"], "modules": ["CO"] }
        ] }
      ] }
    ] }
  ]
}
